# Local development defaults. Replace placeholders before use; .env is ignored.
FUEL_ENV=development
DATABASE_URL=sqlite:///data/diesel-desk-dev.sqlite
FUEL_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
FUEL_ADMIN_EMAIL=admin@example.com
FUEL_ADMIN_NAME=Admin
FUEL_COOKIE_SECURE=false
FUEL_COOKIE_SAMESITE=strict
FUEL_CORS_ORIGINS=
FUEL_METER_TOLERANCE_LITRES=0.10
FUEL_OCR_PROVIDER=tesseract
FUEL_PHOTO_STORAGE=local
TESSERACT_CMD=

# Cloud deployment: replace the example database URL with Neon’s pooled URL.
# Keep DATABASE_URL on the backend; never use it in VITE_* variables.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set DATABASE_URL_UNPOOLED to Neon's direct connection URL for Alembic migrations.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Cloud deployment only: use a private R2 bucket and backend-only credentials.
# FUEL_PHOTO_STORAGE=r2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET_NAME=replace-with-private-bucket-name
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Optional: set only if using Google Cloud Vision OCR.
# GOOGLE_CLOUD_VISION_API_KEY=
